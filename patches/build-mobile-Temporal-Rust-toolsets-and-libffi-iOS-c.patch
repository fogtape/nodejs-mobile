+# Mobile Rust actions select their triple per toolset; desktop builds retain
+# upstream Cargo behavior. See mobile-cargo-build.py.
+{'variables': {'cargo%': 'cargo',
+               'cargo_vendor_dir': './vendor',
+               'temporal_capi_dir': 'temporal_capi-v0_2',
+               'cargo_rust_target%': ''},
+ 'conditions': [['build_type == "Release"',
+                 {'variables': {'cargo_build_flags': ['--release']},
+                  'conditions': [['cargo_rust_target!=""',
+                                  {'variables': {'cargo_build_flags': ['--target',
+                                                                       '<(cargo_rust_target)']}}],
+                                 ['OS=="win"',
+                                  {'variables': {'node_crates_libpath': '<(SHARED_INTERMEDIATE_DIR)/$(Platform)/release/node_crates.lib'}},
+                                  {'variables': {'node_crates_libpath': '<(SHARED_INTERMEDIATE_DIR)/<(cargo_rust_target)/release/<(STATIC_LIB_PREFIX)node_crates<(STATIC_LIB_SUFFIX)'}}]]},
+                 {'variables': {'cargo_build_flags': []},
+                  'conditions': [['OS=="win"',
+                                  {'variables': {'node_crates_libpath': '<(SHARED_INTERMEDIATE_DIR)/$(Platform)/debug/node_crates.lib'}},
+                                  {'variables': {'node_crates_libpath': '<(SHARED_INTERMEDIATE_DIR)/<(cargo_rust_target)/debug/<(STATIC_LIB_PREFIX)node_crates<(STATIC_LIB_SUFFIX)'}}]]}]],
+ 'targets': [{'target_name': 'node_crates',
+              'type': 'none',
+              'toolsets': ['host', 'target'],
+              'hard_dependency': 1,
+              'sources': ['Cargo.toml', 'Cargo.lock', 'src/lib.rs'],
+              'link_settings': {'libraries': ['<(node_crates_libpath)'],
+                                'conditions': [['OS=="win"',
+                                                {'libraries': ['-lntdll', '-luserenv']}]]},
+              'conditions': [['OS in "android ios"',
+                              {'link_settings': {'libraries!': ['<(node_crates_libpath)'],
+                                                 'libraries': ['<(SHARED_INTERMEDIATE_DIR)/mobile-rust/<(_toolset)/libnode_crates.a'],
+                                                 'target_conditions': [['OS=="android" and '
+                                                                        '_toolset=="target"',
+                                                                        {'libraries': ['-ldl',
+                                                                                       '-llog',
+                                                                                       '-lunwind']}]]},
+                               'variables': {'mobile_cargo_flags': []},
+                               'conditions': [['OS=="android"',
+                                               {'variables': {'mobile_cargo_flags': ['--ndk',
+                                                                                     '<(android_ndk_path)',
+                                                                                     '--android-api',
+                                                                                     '<(android_api_level)']}}],
+                                              ['OS=="ios"',
+                                               {'variables': {'mobile_cargo_flags': ['--ios-simulator',
+                                                                                     '<(iossim)']}}]],
+                               'actions': [{'action_name': 'mobile_cargo_build',
+                                            'inputs': ['<@(_sources)',
+                                                       'mobile-cargo-build.py',
+                                                       '.cargo/config.toml'],
+                                            'outputs': ['<(SHARED_INTERMEDIATE_DIR)/mobile-rust/<(_toolset)/libnode_crates.a'],
+                                            'action': ['<(python)',
+                                                       'mobile-cargo-build.py',
+                                                       '--os',
+                                                       '<(OS)',
+                                                       '--arch',
+                                                       '<(target_arch)',
+                                                       '--toolset',
+                                                       '<(_toolset)',
+                                                       '--configuration',
+                                                       '<(build_type)',
+                                                       '--output',
+                                                       '<(SHARED_INTERMEDIATE_DIR)/mobile-rust/<(_toolset)/libnode_crates.a',
+                                                       '<@(mobile_cargo_flags)']}]},
+                              {'conditions': [['OS=="win"',
+                                               {'actions': [{'action_name': 'cargo_build',
+                                                             'inputs': ['<@(_sources)'],
+                                                             'outputs': ['<(node_crates_libpath)'],
+                                                             'action': ['<(python)',
+                                                                        'cargo_build.py',
+                                                                        '$(Platform)',
+                                                                        '<(SHARED_INTERMEDIATE_DIR)',
+                                                                        '<@(cargo_build_flags)',
+                                                                        '--frozen']}]},
+                                               {'actions': [{'action_name': 'cargo_build',
+                                                             'inputs': ['<@(_sources)'],
+                                                             'outputs': ['<(node_crates_libpath)'],
+                                                             'action': ['<(cargo)',
+                                                                        'rustc',
+                                                                        '<@(cargo_build_flags)',
+                                                                        '--frozen',
+                                                                        '--target-dir',
+                                                                        '<(SHARED_INTERMEDIATE_DIR)']}]}]]}]]},
+             {'target_name': 'temporal_capi',
+              'type': 'none',
+              'toolsets': ['host', 'target'],
+              'sources': [],
+              'dependencies': ['node_crates'],
+              'direct_dependent_settings': {'include_dirs': ['<(cargo_vendor_dir)/<(temporal_capi_dir)/bindings/cpp']}}]}
diff --git a/deps/libffi/generate-headers.py b/deps/libffi/generate-headers.py
index fb58edf17b..5369c1e194 100644
--- a/deps/libffi/generate-headers.py
+++ b/deps/libffi/generate-headers.py
@@ -70,7 +70,7 @@ def has_long_double(os_name, target_arch):
     if os_name == 'win':
         return '0'
 
-    if os_name == 'mac' and target_arch == 'arm64':
+    if os_name in ('ios', 'mac') and target_arch == 'arm64':
         return '0'
 
     if target_arch == 'arm':
@@ -81,7 +81,7 @@ def has_long_double(os_name, target_arch):
 
 def uses_exec_trampoline_table(os_name, target_arch):
     target_arch = normalize_arch(target_arch)
-    return os_name == 'mac' and target_arch in ('arm', 'arm64')
+    return os_name in ('ios', 'mac') and target_arch in ('arm', 'arm64')
 
 
 def render_ffi_header(base_dir, os_name, target_arch, target):
@@ -131,7 +131,7 @@ def render_fficonfig(os_name, target_arch):
 
     if uses_exec_trampoline_table(os_name, target_arch):
         lines.append('#define FFI_EXEC_TRAMPOLINE_TABLE 1')
-    elif os_name in ('freebsd', 'mac', 'openbsd'):
+    elif os_name in ('android', 'freebsd', 'mac', 'openbsd'):
         lines.append('#define FFI_MMAP_EXEC_WRIT 1')
 
     if os_name != 'win':
@@ -149,7 +149,7 @@ def render_fficonfig(os_name, target_arch):
             '#define HAVE_MMAP_DEV_ZERO 1',
         ])
 
-    if os_name == 'mac' and target_arch == 'arm64':
+    if os_name in ('ios', 'mac') and target_arch == 'arm64':
         lines.extend([
             '#if defined(__arm64e__)',
             '#define HAVE_ARM64E_PTRAUTH 1',
@@ -261,8 +261,19 @@ def main(argv=None):
     parser.add_argument('--output-dir', required=True)
     parser.add_argument('--target-arch')
     parser.add_argument('--os')
+    parser.add_argument('--toolset', choices=('host', 'target'), default='target')
+    parser.add_argument('--host-arch')
+    parser.add_argument('--host-os')
     args = parser.parse_args(argv)
 
+    if args.toolset == 'host' and args.os in ('android', 'ios'):
+        # V8's Android ARM snapshots use -m32 on x64 Linux hosts.
+        if (args.os == 'android' and args.target_arch in ('arm', 'ia32')
+                and args.host_arch == 'x64'):
+            args.host_arch = 'ia32'
+        args.target_arch = args.host_arch
+        args.os = args.host_os
+
     try:
         generate_headers(args.output_dir,
                          args.target_arch or detect_target_arch(),
