From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gregor MacLennan <gmaclennan@awana.digital>
Date: Tue, 28 Jul 2026 19:20:25 +0000
Subject: [PATCH] build: mobile targets in node.gyp / node.gypi
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The shape of the shipped artifacts: Android builds libnode as a shared
library, iOS as a static library wrapped into a framework, and the
NODE_MOBILE define marks both. Skip cctest on Android shared builds.
Node 26 normally puts the no-snapshot stub in executables, leaving its
static libnode archive with an unresolved GetEmbeddedSnapshotData().
For iOS without Node snapshots, put the upstream stub in libnode so the
framework can link it directly, and remove separate stub copies from
dependent executables to avoid duplicate symbols when force-loading.

Co-authored-by: Jaime Bernardo <jaime@janeasystems.com>
Co-authored-by: Andre Staltz <andre@staltz.com>
Co-authored-by: Julia Samól <j.samol@papers.ch>
---
 node.gyp  | 26 ++++++++++++++++++++++----
 node.gypi | 22 ++++++++++++++++++----
 2 files changed, 40 insertions(+), 8 deletions(-)

diff --git a/node.gyp b/node.gyp
index b129c3db8d..a1bce0bd1f 100644
--- a/node.gyp
+++ b/node.gyp
@@ -69,6 +69,11 @@
       'deps/acorn/acorn/dist/acorn.js',
       'deps/acorn/acorn-walk/dist/walk.js',
       'deps/minimatch/index.js',
+      # mobile: pure-JS WebAssembly polyfill, installed by
+      # internal/process/pre_execution when the engine ships no WebAssembly
+      # (iOS runs V8 jitless). Loaded lazily, so builds that never touch
+      # WebAssembly only pay its ~100 KB of source in the binary.
+      'deps/polywasm/polywasm.js',
       '<@(node_builtin_shareable_builtins)',
     ],
     'node_sources': [
@@ -979,6 +984,16 @@
             'src/node_snapshot_stub.cc',
           ]
         }],
+        [ 'OS=="ios" and node_shared=="false" and node_use_node_snapshot=="false"', {
+          # The framework links libnode directly, without the node executable
+          # that normally supplies GetEmbeddedSnapshotData() in Node 26.
+          'sources': [ 'src/node_snapshot_stub.cc' ],
+          # Executables linking this archive must use its copy of the stub,
+          # including force-loaded consumers such as node and cctest.
+          'direct_dependent_settings': {
+            'sources!': [ 'src/node_snapshot_stub.cc' ],
+          },
+        }],
         [ 'node_use_bundled_v8!="false"', {
           'dependencies': [ 'tools/v8_gypfiles/abseil.gyp:abseil' ],
         }],
@@ -1086,7 +1101,8 @@
             '<@(node_quic_sources)',
           ],
         }],
-        [ 'OS in "linux freebsd mac solaris openharmony" and '
+        # nodejs-mobile patch to mention iOS
+        [ 'OS in "linux freebsd mac ios solaris openharmony" and '
           'target_arch=="x64" and '
           'node_target_type=="executable"', {
           'defines': [ 'NODE_ENABLE_LARGE_CODE_PAGES=1' ],
@@ -1431,8 +1447,9 @@
         ['OS=="solaris"', {
           'ldflags': [ '-I<(SHARED_INTERMEDIATE_DIR)' ]
         }],
-        # Skip cctest while building shared lib node for Windows
-        [ 'OS=="win" and node_shared=="true"', {
+        # Skip cctest while building shared lib node for Windows and Android
+        # (the only mobile target built --shared; iOS links libnode statically)
+        [ 'OS in ("win", "android") and node_shared=="true"', {
           'type': 'none',
         }],
         [ 'node_shared=="true"', {
@@ -1657,7 +1674,8 @@
         [ 'node_shared_libuv=="false"', {
           'dependencies': [ 'deps/uv/uv.gyp:libuv#host' ],
         }],
-        [ 'OS in "linux mac openharmony"', {
+        # nodejs-mobile patch: add ios
+        [ 'OS in "linux mac ios openharmony"', {
           'defines': ['NODE_JS2C_USE_STRING_LITERALS'],
         }],
         [ 'debug_node=="true"', {
diff --git a/node.gypi b/node.gypi
index 3636633c62..49559662d7 100644
--- a/node.gypi
+++ b/node.gypi
@@ -271,6 +271,11 @@
         'NODE_PLATFORM="darwin"',
       ],
     }],
+    # nodejs-mobile patch: link CoreFoundation and Security frameworks when compiling for iOS
+    [ 'OS=="ios"', {
+      # linking Corefoundation and Security is needed for crypto functionality
+      'libraries': [ '-framework CoreFoundation -framework Security' ],
+    }],
     [ 'OS=="freebsd"', {
       'libraries': [
         '-lutil',
@@ -349,7 +354,7 @@
         ],
       },
     }],
-    [ 'coverage=="true" and node_shared=="false" and OS in "mac freebsd linux openharmony"', {
+    [ 'coverage=="true" and node_shared=="false" and OS in "mac ios freebsd linux openharmony"', {
       'cflags!': [ '-O3' ],
       'ldflags': [ '--coverage',
                    '-g',
@@ -397,11 +402,15 @@
           'defines': [ 'OPENSSL_API_COMPAT=0x10100000L', ],
           'dependencies': [
             './deps/openssl/openssl.gyp:openssl',
-
-            # For tests
-            './deps/openssl/openssl.gyp:openssl-cli',
           ],
           'conditions': [
+            [ 'OS not in "ios android"', {
+              'dependencies': [
+                # Not needed for iOS and Android, doesn't build
+                # For tests
+                './deps/openssl/openssl.gyp:openssl-cli',
+              ],
+            }],
             # -force_load or --whole-archive are not applicable for
             # the static library
             [ 'force_load=="true"', {
@@ -478,5 +487,10 @@
     }, {
       'defines': [ 'HAVE_QUIC=0' ]
     }],
+    [ 'OS=="android" or OS=="ios"', {
+      'defines': [
+        'NODE_MOBILE',
+      ],
+    }],
   ],
 }
